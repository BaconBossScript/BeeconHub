-- [13] DYNAMIC LUARMOR DATA SYNC & AUTO-EXECUTION ENGINE
local function syncLuarmorData(isInitialLaunch)
    local spin = TweenService:Create(SyncBtn, TweenInfo.new(0.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Rotation = 360 })
    spin:Play()

    task.spawn(function()
        local headers = {
            ["Authorization"] = LUARMOR_API_KEY,
            ["Content-Type"] = "application/json"
        }
        local jsonStr = universalGet(LUARMOR_ENDPOINT, headers)
        spin:Cancel()
        SyncBtn.Rotation = 0

        local parsedList = {}
        local isLive = false
        local isCached = false

        if jsonStr then
            local ok, data = pcall(function() return HttpService:JSONDecode(jsonStr) end)
            if ok and data and data.projects then
                isLive = true
                pcall(function()
                    if writefile then writefile(CACHE_PATH, jsonStr) end
                end)
                for _, proj in ipairs(data.projects) do
                    if proj.scripts then
                        for _, scr in ipairs(proj.scripts) do
                            local scriptName = scr.script_name or proj.name or "Unnamed Script"
                            local autoCat, autoIcon = autoDetectCategoryAndIcon(scriptName)

                            table.insert(parsedList, {
                                name = scriptName,
                                id = scr.script_id or "",
                                ver = scr.script_version or "v1.0",
                                category = autoCat,
                                icon = autoIcon,
                                ffa = scr.ffa,
                                silent = scr.silent
                            })
                        end
                    end
                end
            end
        end

        -- Offline / Lag Fallback Cache
        if not isLive and isfile and isfile(CACHE_PATH) then
            pcall(function()
                local cachedStr = readfile(CACHE_PATH)
                if cachedStr and #cachedStr > 0 then
                    local ok, data = pcall(function() return HttpService:JSONDecode(cachedStr) end)
                    if ok and data and data.projects then
                        isCached = true
                        for _, proj in ipairs(data.projects) do
                            if proj.scripts then
                                for _, scr in ipairs(proj.scripts) do
                                    local scriptName = scr.script_name or proj.name or "Unnamed Script"
                                    local autoCat, autoIcon = autoDetectCategoryAndIcon(scriptName)

                                    table.insert(parsedList, {
                                        name = scriptName,
                                        id = scr.script_id or "",
                                        ver = scr.script_version or "v1.0",
                                        category = autoCat,
                                        icon = autoIcon,
                                        ffa = scr.ffa,
                                        silent = scr.silent
                                    })
                                end
                            end
                        end
                    end
                end
            end)
        end

        if isLive and #parsedList > 0 then
            ActiveGameList = parsedList
            showToast("Synced " .. tostring(#parsedList) .. " games from Luarmor!", true)
        elseif isCached and #parsedList > 0 then
            ActiveGameList = parsedList
            showToast("Loaded " .. tostring(#parsedList) .. " games from Cache!", true)
        else
            ActiveGameList = DefaultGameDatabase
            showToast("🐝 Beecon Hub ready! (" .. tostring(#DefaultGameDatabase) .. " games)", true)
        end

        renderGameList()

        -- Auto-Execute if the current game is supported by Luarmor and a saved key exists
        if isInitialLaunch then
            local matched = findMatchingScript(ActiveGameList, CurrentGameName)
            if matched and matched.id and #matched.id == 32 then
                if script_key and #script_key > 5 then
                    showToast("🚀 Matched " .. matched.name .. "! Auto-executing...", true)
                    task.delay(0.6, function()
                        verifyAndExecuteKey(script_key, matched.id, true)
                    end)
                else
                    showToast("ℹ️ " .. matched.name .. " supported! Enter key to run.", true)
                end
            end
        end
    end)
end

