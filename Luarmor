-- Universal Multi-Executor HTTP Requester Engine
local function universalGet(url, customHeaders)
    -- All possible executor request functions across PC, Mobile, and Mac
    local reqFn = (syn and syn.request) 
        or (http and http.request) 
        or http_request 
        or request 
        or (fluxus and fluxus.request) 
        or (krnl and krnl.request)

    local reqHeaders = {
        ["Authorization"] = LUARMOR_API_KEY,
        ["Content-Type"] = "application/json",
        ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
        ["Accept"] = "application/json, text/plain, */*"
    }
    if customHeaders then
        for k, v in pairs(customHeaders) do
            reqHeaders[k] = v
        end
    end

    -- 1. Try Executor Request function (up to 3 retries for high latency / join lag)
    if reqFn then
        for attempt = 1, 3 do
            local success, res = pcall(function()
                return reqFn({
                    Url = url,
                    Method = "GET",
                    Headers = reqHeaders
                })
            end)
            if success and type(res) == "table" then
                -- Handle both UpperCase (Body, StatusCode) and lowerCase (body, status_code)
                local body = res.Body or res.body or res.Response or res.response
                local status = res.StatusCode or res.status_code or res.Status or res.status or res.statusCode
                if body and type(body) == "string" and #body > 0 then
                    local statusNum = tonumber(status)
                    if not statusNum or (statusNum >= 200 and statusNum < 300) then
                        return body
                    end
                end
            end
            if attempt < 3 then task.wait(0.4) end
        end
    end

    -- 2. Fallback to game:HttpGet (works on basic executors)
    local success, body = pcall(function()
        return game:HttpGet(url, true)
    end)
    if success and body and type(body) == "string" and #body > 0 then
        return body
    end

    return nil
end

