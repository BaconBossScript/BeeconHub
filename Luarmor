-- Forward declarations for dynamic state
local currentMatchedScript = nil
local updateKeyUIStatus

-- [9] KEY SYSTEM ENGINE & VERIFICATION
local function verifyAndExecuteKey(inputKey, targetScriptId, autoExecute)
    local keyToCheck = inputKey or script_key
    if not keyToCheck or #keyToCheck:gsub("%s+", "") == 0 then
        showToast("Please enter or paste your Key first!", false)
        switchTab("Key")
        return false
    end

    if not LuarmorAPI then
        pcall(function()
            LuarmorAPI = loadstring(game:HttpGet("https://sdkAPI-public.luarmor.net/library.lua"))()
            getgenv().API = LuarmorAPI
        end)
    end

    if not LuarmorAPI then
        showToast("Luarmor SDK is loading, please wait...", false)
        return false
    end

    local activeScriptId = targetScriptId 
        or (currentMatchedScript and currentMatchedScript.id and #currentMatchedScript.id == 32 and currentMatchedScript.id)
        or DEFAULT_SCRIPT_ID

    LuarmorAPI.script_id = activeScriptId

    showToast("Verifying key with Luarmor Server...", true)
    
    local status = nil
    local ok = pcall(function()
        status = LuarmorAPI.check_key(keyToCheck)
    end)

    if ok and status and status.code == "KEY_VALID" then
        script_key = keyToCheck
        getgenv().script_key = script_key
        pcall(function() writefile(KEY_PATH, script_key) end)

        local duration, expire = parseKeyDuration(status)
        KeyState.isValid = true
        KeyState.keyText = script_key
        KeyState.durationText = duration
        KeyState.expiryText = expire
        KeyState.statusBadge = "🟢 KEY ACTIVE"
        KeyState.hwidStatus = "Bound to HWID ✅"

        if updateKeyUIStatus then updateKeyUIStatus() end
        showToast("Key Valid! Duration: " .. duration, true)
        
        if autoExecute and LuarmorAPI.load_script then
            task.spawn(function()
                pcall(function() LuarmorAPI.load_script() end)
            end)
        end
        return true
    elseif status and status.code and status.code:find("KEY_") then
        local msgs = {
            KEY_HWID_LOCKED = "Key linked to another HWID! Please reset via bot.",
            KEY_INCORRECT = "Key is incorrect!",
            KEY_INVALID = "Key is invalid or formatted incorrectly!"
        }
        KeyState.isValid = false
        KeyState.statusBadge = "🔴 " .. (status.code)
        KeyState.durationText = "Invalid / Expired"
        KeyState.hwidStatus = (status.code == "KEY_HWID_LOCKED") and "Locked to another HWID" or "N/A"
        if updateKeyUIStatus then updateKeyUIStatus() end

        showToast(msgs[status.code] or "Key error: " .. status.code, false)
        switchTab("Key")
        return false
    else
        showToast("Key check failed: " .. tostring(status and status.message or "Server error"), false)
        return false
    end
end

