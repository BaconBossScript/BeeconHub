-- Helper to strip apostrophes, quotes, and punctuation for seamless matching
local function normalizeGameName(str)
    if not str then return "" end
    return str:lower():gsub("['\"`’‘]", ""):gsub("[%p%c%s]", "")
end

local function cleanWordList(str)
    if not str then return {} end
    local noApos = str:lower():gsub("['\"`’‘]", ""):gsub("[%p%c]", " ")
    local words = {}
    for w in noApos:gmatch("%S+") do
        if #w >= 2 then
            table.insert(words, w)
        end
    end
    return words
end

-- Dynamic Fuzzy Game Matching (Apostrophe & Symbol Insensitive)
local function findMatchingScript(gameList, robloxGameName)
    local cleanCurrent = normalizeGameName(robloxGameName)
    if #cleanCurrent == 0 then return nil end

    -- 1. Direct normalized match or substring inclusion
    for _, scr in ipairs(gameList) do
        local cleanScr = normalizeGameName(scr.name)
        if cleanCurrent == cleanScr or cleanCurrent:find(cleanScr, 1, true) or cleanScr:find(cleanCurrent, 1, true) then
            return scr
        end
    end

    -- 2. Multi-word token match (e.g. "Sol's RNG" matches "Sols RNG")
    local robloxWords = cleanWordList(robloxGameName)
    local bestMatch = nil
    local highestMatchCount = 0

    for _, scr in ipairs(gameList) do
        local scrWords = cleanWordList(scr.name)
        local matches = 0
        for _, sw in ipairs(scrWords) do
            for _, rw in ipairs(robloxWords) do
                if sw == rw or (sw:find(rw, 1, true) and #rw >= 3) or (rw:find(sw, 1, true) and #sw >= 3) then
                    matches = matches + 1
                    break
                end
            end
        end

        if matches > highestMatchCount and (matches >= 2 or (#scrWords == 1 and matches == 1)) then
            highestMatchCount = matches
            bestMatch = scr
        end
    end

    return bestMatch
end

-- Helper to format Key Expiry / Duration
local function parseKeyDuration(status)
    if not status then return "Unknown", "N/A" end
    
    local expire = status.auth_expire or status.expire or status.expires_at or status.expiry or status.time_left
    if expire then
        if type(expire) == "number" then
            if expire <= 0 or expire > 2000000000 then
                return "Permanent / Lifetime", "No Expiration"
            end
            local diff = expire - os.time()
            if diff <= 0 then
                return "Expired", "0h 0m (Key Expired)"
            end
            local days = math.floor(diff / 86400)
            local hours = math.floor((diff % 86400) / 3600)
            local mins = math.floor((diff % 3600) / 60)
            local durationStr = ""
            if days > 0 then
                durationStr = string.format("%dd %dh remaining", days, hours)
            elseif hours > 0 then
                durationStr = string.format("%dh %dm remaining", hours, mins)
            else
                durationStr = string.format("%dm remaining", mins)
            end
            return "Active (" .. durationStr .. ")", os.date("%Y-%m-%d %H:%M:%S", expire)
        else
            return tostring(expire), tostring(expire)
        end
    end
    
    if status.code == "KEY_VALID" then
        return "24 Hours (Active)", "24h Session Key"
    end
    
    return "Invalid / Expired", "N/A"
end

-- Clean version formatter
local function formatVersion(rawVer)
    if not rawVer or rawVer == "" then return "v1.0" end
    local num = rawVer:match("%d+")
    if num then
        if #num == 4 then
            local major = tonumber(num:sub(1, 2)) or 1
            local minor = tonumber(num:sub(3, 4)) or 0
            return string.format("v%d.%d", major, minor)
        elseif not rawVer:lower():find("v") then
            return "v" .. rawVer
        end
    end
    return rawVer
end

