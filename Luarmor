local function renderGameList()
    for _, c in ipairs(CardInstances) do c:Destroy() end
    table.clear(CardInstances)

    local rawQuery = SearchInput.Text:lower()
    local cleanQuery = normalizeGameName(SearchInput.Text)
    local filteredCount = 0

    local matchedScript = findMatchingScript(ActiveGameList, CurrentGameName)
    updateCurrentGameHero(matchedScript)

    for _, item in ipairs(ActiveGameList) do
        local cleanItemName = normalizeGameName(item.name)
        local matchesSearch = (cleanQuery == "") 
            or string.find(item.name:lower(), rawQuery, 1, true)
            or string.find(cleanItemName, cleanQuery, 1, true)
            or (item.id and string.find(item.id:lower(), rawQuery, 1, true))

        local matchesCategory = (activeCategory == "All")
            or (item.category and string.find(item.category:lower(), activeCategory:lower(), 1, true))

        if matchesSearch and matchesCategory then
            filteredCount = filteredCount + 1
            local isCurrent = (matchedScript and matchedScript.id == item.id)
            createGameCard(item, isCurrent)
        end
    end

    if filteredCount == 0 then
        local emptyCard = Instance.new("Frame")
        emptyCard.Size = UDim2.new(1, -6, 0, 80)
        emptyCard.BackgroundColor3 = Colors.CardBg
