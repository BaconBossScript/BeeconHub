-- // Services
local CoreGui = game:GetService("CoreGui")
local VIM = game:GetService("VirtualInputManager")

-- // Constants
local TOGGLE_SIZE = 40
local CORNER_RADIUS = 7
local LOGO_ASSET = "http://www.roblox.com/asset/?id=18868921989"

local COLORS = {
    Background = Color3.fromRGB(25, 25, 25),
    Logo = Color3.fromRGB(255, 255, 255),
}

-- // Main GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "anti_crack"
ScreenGui.Parent = CoreGui

-- // Toggle Button
local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ToggleButton"
ToggleButton.Size = UDim2.new(0, TOGGLE_SIZE, 0, TOGGLE_SIZE)
ToggleButton.Position = UDim2.new(0, 10, 0, 10)
ToggleButton.BackgroundColor3 = COLORS.Background
ToggleButton.Text = ""
ToggleButton.Parent = ScreenGui

-- // Corner
local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, CORNER_RADIUS)
UICorner.Parent = ToggleButton

-- // Logo
local Logo = Instance.new("ImageLabel")
Logo.Name = "Logo"
Logo.Parent = ToggleButton
Logo.BackgroundColor3 = COLORS.Logo
Logo.BackgroundTransparency = 1
Logo.Position = UDim2.new(0, 0, 0, 0)
Logo.Size = UDim2.new(1, 0, 1, 0)
Logo.Image = LOGO_ASSET

-- // Functions
local function simulateKeyPress()
    VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
    task.wait(0.05) -- small delay for reliability
    VIM:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
end

-- // Events
ToggleButton.MouseButton1Click:Connect(simulateKeyPress)
ToggleButton.TouchTap:Connect(simulateKeyPress) -- mobile support

-- // Drag
ToggleButton.Draggable = true
